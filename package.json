{
	"name": "layeredkb",
	"displayName": "LayeredKB",
	"description": "Personal Knowledge Base のワークスペースを「スキーマ層 / 知見層 / その他」のレイヤーで整理して表示する VS Code 拡張機能．",
	"version": "0.1.0",
	"license": "MIT",
	"publisher": "del-taiseiozaki",
	"repository": {
		"type": "git",
		"url": "https://github.com/DeL-TaiseiOzaki/LayeredKB-vscode-extention.git"
	},
	"engines": {
		"vscode": "^1.105.0"
	},
	"categories": [
		"Other"
	],
	"keywords": [
		"knowledge base",
		"PKB",
		"explorer",
		"claude",
		"agents"
	],
	"activationEvents": [
		"workspaceContains:**/*"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"views": {
			"explorer": [
				{
					"id": "layeredkb.layers",
					"name": "LayeredKB",
					"icon": "$(layers)",
					"contextualTitle": "LayeredKB"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "layeredkb.layers",
				"contents": "フォルダーを開くと，ファイルをレイヤーごとに整理して表示します．\n[フォルダーを開く](command:vscode.openFolder)",
				"when": "workbenchState == empty"
			}
		],
		"commands": [
			{
				"command": "layeredkb.refresh",
				"title": "Refresh Layers",
				"category": "LayeredKB",
				"icon": "$(refresh)"
			},
			{
				"command": "layeredkb.configureLayers",
				"title": "Configure Layers",
				"category": "LayeredKB",
				"icon": "$(gear)"
			},
			{
				"command": "layeredkb.openToSide",
				"title": "Open to the Side",
				"category": "LayeredKB"
			},
			{
				"command": "layeredkb.revealInExplorer",
				"title": "Reveal in Explorer View",
				"category": "LayeredKB"
			},
			{
				"command": "layeredkb.revealFileInOS",
				"title": "Reveal in File Explorer",
				"category": "LayeredKB"
			},
			{
				"command": "layeredkb.copyPath",
				"title": "Copy Path",
				"category": "LayeredKB"
			},
			{
				"command": "layeredkb.copyRelativePath",
				"title": "Copy Relative Path",
				"category": "LayeredKB"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "layeredkb.openToSide",
					"when": "false"
				},
				{
					"command": "layeredkb.revealInExplorer",
					"when": "false"
				},
				{
					"command": "layeredkb.revealFileInOS",
					"when": "false"
				},
				{
					"command": "layeredkb.copyPath",
					"when": "false"
				},
				{
					"command": "layeredkb.copyRelativePath",
					"when": "false"
				}
			],
			"view/title": [
				{
					"command": "layeredkb.refresh",
					"when": "view == layeredkb.layers",
					"group": "navigation@1"
				},
				{
					"command": "layeredkb.configureLayers",
					"when": "view == layeredkb.layers",
					"group": "navigation@2"
				}
			],
			"view/item/context": [
				{
					"command": "layeredkb.openToSide",
					"when": "view == layeredkb.layers && viewItem == layeredkb.file",
					"group": "navigation@1"
				},
				{
					"command": "layeredkb.revealInExplorer",
					"when": "view == layeredkb.layers && viewItem == layeredkb.file",
					"group": "2_reveal@1"
				},
				{
					"command": "layeredkb.revealFileInOS",
					"when": "view == layeredkb.layers && viewItem == layeredkb.file",
					"group": "2_reveal@2"
				},
				{
					"command": "layeredkb.copyPath",
					"when": "view == layeredkb.layers && viewItem == layeredkb.file",
					"group": "3_copy@1"
				},
				{
					"command": "layeredkb.copyRelativePath",
					"when": "view == layeredkb.layers && viewItem == layeredkb.file",
					"group": "3_copy@2"
				}
			]
		},
		"configuration": {
			"title": "LayeredKB",
			"properties": {
				"layeredkb.layers": {
					"type": "array",
					"markdownDescription": "レイヤーの定義．上から順に評価され，最初に一致したレイヤーが採用されます．どのレイヤーにも一致しないファイルは `Other` に入ります．",
					"default": [
						{
							"id": "schema",
							"label": "Schema",
							"description": "CLI エージェントの振る舞いを規定する層（.claude, AGENTS.md など）",
							"icon": "law",
							"badge": "S",
							"color": "charts.purple",
							"patterns": [
								".claude/**",
								".claude.json",
								"**/CLAUDE.md",
								"**/CLAUDE.local.md",
								"**/AGENTS.md",
								".agents/**",
								".codex/**",
								".cursor/**",
								".cursorrules",
								".gemini/**",
								"**/GEMINI.md",
								".github/copilot-instructions.md",
								".github/instructions/**",
								".github/prompts/**",
								".windsurfrules",
								".mcp.json"
							]
						},
						{
							"id": "knowledge",
							"label": "Knowledge",
							"description": "知見・情報とオントロジー（Markdown / CSV）",
							"icon": "book",
							"badge": "K",
							"color": "charts.blue",
							"patterns": [
								"**/*.md",
								"**/*.mdx",
								"**/*.csv",
								"**/*.tsv"
							]
						}
					],
					"items": {
						"type": "object",
						"required": [
							"id",
							"label",
							"patterns"
						],
						"properties": {
							"id": {
								"type": "string",
								"description": "レイヤーの一意な ID（\"other\" は予約済み）"
							},
							"label": {
								"type": "string",
								"description": "ツリーに表示する名前"
							},
							"description": {
								"type": "string",
								"description": "ツールチップに表示する説明"
							},
							"icon": {
								"type": "string",
								"description": "codicon の名前（例: law, book, database, beaker）"
							},
							"badge": {
								"type": "string",
								"maxLength": 2,
								"description": "標準エクスプローラーに表示するバッジ（1〜2 文字）"
							},
							"color": {
								"type": "string",
								"description": "標準エクスプローラーの装飾に使うテーマカラー ID（例: charts.blue）"
							},
							"patterns": {
								"type": "array",
								"items": {
									"type": "string"
								},
								"description": "ワークスペースルートからの相対 glob パターン"
							}
						}
					}
				},
				"layeredkb.exclude": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [
						"**/node_modules/**",
						"**/.git/**",
						"**/dist/**",
						"**/out/**"
					],
					"description": "走査から除外する glob パターン（`files.exclude` に加えて適用されます）"
				},
				"layeredkb.showOtherLayer": {
					"type": "boolean",
					"default": true,
					"description": "どのレイヤーにも属さないファイルを `Other` レイヤーとして表示する"
				},
				"layeredkb.compactFolders": {
					"type": "boolean",
					"default": true,
					"description": "子が 1 つしかないフォルダーを 1 行にまとめて表示する（エクスプローラーのコンパクトフォルダーと同様）"
				},
				"layeredkb.decorateExplorer": {
					"type": "boolean",
					"default": true,
					"description": "標準エクスプローラー上のファイルにレイヤーのバッジと色を付ける"
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run package",
		"compile": "npm run check-types && npm run lint && node esbuild.js",
		"watch": "npm-run-all -p watch:*",
		"watch:esbuild": "node esbuild.js --watch",
		"watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
		"package": "npm run check-types && npm run lint && node esbuild.js --production",
		"compile-tests": "tsc -p . --outDir out",
		"watch-tests": "tsc -p . -w --outDir out",
		"pretest": "npm run compile-tests && npm run compile",
		"check-types": "tsc --noEmit",
		"lint": "eslint src",
		"test": "vscode-test",
		"test:unit": "npm run compile-tests && mocha --ui tdd \"out/test/unit/**/*.test.js\""
	},
	"dependencies": {
		"minimatch": "^10.2.6"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/mocha": "^10.0.10",
		"@types/node": "^22.18.0",
		"@types/vscode": "^1.105.0",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^3.1.0",
		"esbuild": "^0.28.2",
		"eslint": "^10.9.1",
		"mocha": "^12.0.0",
		"npm-run-all2": "^9.0.3",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.44.0"
	},
	"overrides": {
		"mocha": "^12.0.0"
	}
}
